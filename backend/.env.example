# ==============================================================================
# SmartPill Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit a real .env file — it is excluded by .gitignore.
# ==============================================================================

# Server binding (local dev only — Vercel ignores HOST/PORT)
HOST=127.0.0.1
PORT=5000

# MongoDB connection URI
# - Local dev:      mongodb://127.0.0.1:27017/smartpill
# - Production:     mongodb+srv://<user>:<password>@cluster.mongodb.net/smartpill?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# JWT signing secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_secret

# JWT token lifetime (default: 7 days)
JWT_EXPIRES_IN=7d

# CORS allowed frontend origin
# - Local dev:      http://127.0.0.1:5173
# - Production:     https://your-project-name.vercel.app
#   (Must match your Vercel deployment URL — set this in Vercel env vars dashboard)
FRONTEND_URL=http://127.0.0.1:5173

# Deployment environment (set to "production" in Vercel env vars)
NODE_ENV=development
