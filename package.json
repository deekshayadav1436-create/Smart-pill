{
  "name": "smartpill-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SmartPill - Health Management System (Full Stack Monorepo, Vercel-Ready)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,SRC\" -c \"blue.bold,cyan.bold\" \"npm run backend\" \"npm run src\"",
    "start": "npm run dev",
    "backend": "npm run start --prefix api",
    "backend:dev": "npm run dev --prefix api",
    "src": "npm run dev --prefix src",
    "install:backend": "npm install --prefix api",
    "install:src": "npm install --prefix src",
    "install:all": "npm install",
    "build:src": "npm run build --prefix src",
    "build": "npm run build --prefix src"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "api",
    "src"
  ]
}