# PostgreSQL connection string for the SmartPill API
DATABASE_URL=postgresql://user:password@localhost:5432/smartpill

# Use a long, random value in production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

HOST=127.0.0.1
PORT=5000
FRONTEND_URL=http://127.0.0.1:5173
NODE_ENV=development
VITE_API_URL=
