# SmartPill Monorepo - Environment Variables Reference for Local & Vercel
# For Vercel deployment: Set these in Project Settings -> Environment Variables

# ============================================================
# REQUIRED FOR VERCEL PRODUCTION:
# MongoDB Atlas connection string (NOT local MongoDB)
# The local URL mongodb://127.0.0.1:27017/smartpill will NOT work on Vercel.
#
# Steps to get a free MongoDB Atlas URI:
#   1. Go to https://www.mongodb.com/atlas and create a free account
#   2. Create a free M0 cluster
#   3. Create a database user with read/write access
#   4. Under "Network Access", add IP 0.0.0.0/0 (Allow access from anywhere)
#   5. Click "Connect" -> "Connect your application" -> copy the URI
#   6. Replace <password> with your actual password
#   7. Set this as MONGODB_URI in Vercel Project Settings -> Environment Variables
# ============================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartpill?retryWrites=true&w=majority

# Secret key for JWT authentication tokens (REQUIRED)
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# JWT expiration period (default: 7d)
JWT_EXPIRES_IN=7d

# Environment mode
NODE_ENV=production

# Allowed CORS origin for production (default: same origin on Vercel)
# FRONTEND_URL=https://your-smart-pill-project.vercel.app

# Frontend API URL (leave empty for same-origin reverse proxy on Vercel)
VITE_API_URL=
