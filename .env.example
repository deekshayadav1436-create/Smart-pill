# SmartPill Monorepo - Environment Variables Reference for Local & Vercel
# For Vercel deployment: Set these in Project Settings -> Environment Variables

# MongoDB Atlas connection string (REQUIRED for Vercel production)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartpill?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smartpill

# Secret key for JWT authentication tokens (REQUIRED)
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# JWT expiration period (default: 7d)
JWT_EXPIRES_IN=7d

# Environment mode
NODE_ENV=development

# Allowed CORS origin for production (default: same origin on Vercel)
# FRONTEND_URL=https://your-smart-pill-project.vercel.app

# Frontend API URL (leave empty for same-origin reverse proxy)
VITE_API_URL=
